[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer   = 10/20/2026, 1.1.1.0
CatalogFile = csaudiointcsof.cat
PnpLockDown = 1

[SourceDisksNames]
222="Intel SOF Audio Driver Disk","",222

[SourceDisksFiles]
csaudiointcsof.sys=222
sof-apl.ri=222
sof-glk.ri=222
sof-cnl.ri=222
sof-jsl.ri=222
sof-tgl.ri=222

[SignatureAttributes]
csaudiointcsof.sys=SignatureAttributes.DRM

[SignatureAttributes.DRM]
DRMLevel=1300

[SignatureAttributes.PETrust]
PETrust=true

[Manufacturer]
%MfgName%=CSAUDIOINTCSOF,NT$ARCH$

[CSAUDIOINTCSOF.NT$ARCH$]
%CSAUDIOINTCSOF.DeviceDesc%=CSAUDIOINTCSOF_Inst, CSAUDIO\ADSP&CTLR_VEN_8086&CTLR_DEV_9D70 ; Intel Skylake
%CSAUDIOINTCSOF.DeviceDesc%=CSAUDIOINTCSOF_Inst, CSAUDIO\ADSP&CTLR_VEN_8086&CTLR_DEV_9D71 ; Intel Kaby Lake
